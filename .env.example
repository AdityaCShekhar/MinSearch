# Copy this file to .env to override local Docker Compose defaults.
# Values here are for local development only and must not be used in production.

POSTGRES_DB=minsearch
POSTGRES_USER=minsearch
POSTGRES_PASSWORD=minsearch_dev_password
POSTGRES_PORT=5432

REDIS_PORT=6379
KAFKA_PORT=9092
APP_PORT=8080

# At least 32 characters. Replace in every shared or deployed environment.
MINSEARCH_SECURITY_JWT_SECRET=local-only-change-this-minsearch-secret-key

# JVM memory is container-aware; override for local profiling when needed.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
