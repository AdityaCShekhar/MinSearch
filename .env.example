# Copy this file to .env to override local Docker Compose defaults.
# Values here are for local development only and must not be used in production.

AUTH_POSTGRES_DB=minsearch_auth
AUTH_POSTGRES_USER=minsearch_auth
AUTH_POSTGRES_PASSWORD=minsearch_auth_dev_password
AUTH_POSTGRES_PORT=5432

DOCUMENT_POSTGRES_DB=minsearch_document
DOCUMENT_POSTGRES_USER=minsearch_document
DOCUMENT_POSTGRES_PASSWORD=minsearch_document_dev_password
DOCUMENT_POSTGRES_PORT=5433

SEARCH_POSTGRES_DB=minsearch_search
SEARCH_POSTGRES_USER=minsearch_search
SEARCH_POSTGRES_PASSWORD=minsearch_search_dev_password
SEARCH_POSTGRES_PORT=5434

REDIS_PORT=6379
MINSEARCH_CACHE_REDIS_ENABLED=true
MINSEARCH_REDIS_PASSWORD=minsearch_dev_cache_password
KAFKA_PORT=9092
APP_PORT=8080
AUTH_PORT=8081
DOCUMENT_PORT=8082
SEARCH_PORT=8083

# At least 32 characters. Replace in every shared or deployed environment.
MINSEARCH_SECURITY_JWT_SECRET=local-only-change-this-minsearch-secret-key

# JVM memory is container-aware; override for local profiling when needed.
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError

# Development defaults are rejected when production mode is enabled.
MINSEARCH_DEPLOYMENT_MODE=development
MINSEARCH_SECURITY_JWT_PREVIOUS_SECRET=
# Exact comma-separated browser origins; empty disables cross-origin browser access.
MINSEARCH_SECURITY_CORS_ALLOWED_ORIGINS=
MINSEARCH_SECURITY_REQUESTS_PER_MINUTE=1200
