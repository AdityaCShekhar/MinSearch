+
+  @Override
+  @Transactional(readOnly = true)
+  public void forEach(java.util.function.Consumer<StoredMutation> consumer) {
+    // PostgreSQL cursors require a transaction and a positive fetch size. Keep decoded token
+    // mutations bounded instead of retaining the entire corpus alongside the reconstructed index.
+    jdbc.query(connection -> {
+      var statement = connection.prepareStatement("SELECT revision, mutation FROM search_index_documents ORDER BY revision");
+      statement.setFetchSize(128);
+      return statement;
+    }, (org.springframework.jdbc.core.RowCallbackHandler) row -> consumer.accept(new StoredMutation(
+        row.getLong("revision"), mapper.readValue(row.getString("mutation"), Mutation.class))));
+  }
 }
